{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "rum/view-schema.json",
  "title": "RumViewEvent",
  "type": "object",
  "description": "Schema of all properties of a View event",
  "allOf": [
    {
      "$ref": "_common-schema.json"
    },
    {
      "required": ["type", "view"],
      "properties": {
        "type": {
          "type": "string",
          "description": "RUM event type",
          "const": "view",
          "readOnly": true
        },
        "view": {
          "type": "object",
          "description": "View properties",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "string",
              "description": "UUID of the view",
              "readOnly": true
            },
            "name": {
              "type": "string",
              "description": "Page route name",
              "readOnly": false
            },
            "loading_time": {
              "type": "integer",
              "description": "View loading time in ns",
              "minimum": 0,
              "readOnly": true
            },
            "time_spent": {
              "type": "integer",
              "description": "Time spent on view in ns",
              "minimum": 0,
              "readOnly": true
            }
          },
          "readOnly": true
        }
      }
    }
  ]
}
