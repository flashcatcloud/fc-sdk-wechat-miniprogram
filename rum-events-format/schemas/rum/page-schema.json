{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "rum/page-schema.json",
  "title": "RumPageEvent",
  "type": "object",
  "description": "Schema of all properties of a Page event",
  "allOf": [
    {
      "$ref": "_common-schema.json"
    },
    {
      "required": ["type", "page"],
      "properties": {
        "type": {
          "type": "string",
          "description": "RUM event type",
          "const": "page",
          "readOnly": true
        },
        "page": {
          "type": "object",
          "description": "Page properties",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "string",
              "description": "UUID of the page",
              "readOnly": true
            },
            "name": {
              "type": "string",
              "description": "Page route name",
              "readOnly": false
            },
            "loading_time": {
              "type": "integer",
              "description": "Page loading time in ns",
              "minimum": 0,
              "readOnly": true
            },
            "time_spent": {
              "type": "integer",
              "description": "Time spent on page in ns",
              "minimum": 0,
              "readOnly": true
            }
          },
          "readOnly": true
        }
      }
    }
  ]
}
